# Copy to .env and fill in your own keys. Never commit a real .env.

# Required: Gemini API key used for translation (free tier works).
GEMINI_API_KEY=

# Optional: comma-separated Gemini keys for TTS rotation.
# Falls back to GEMINI_API_KEY when empty.
GEMINI_TTS_API_KEYS=

# Optional: password for the /admin reviews page. Empty disables it.
DUBLAB_ADMIN_KEY=

# Optional: watermark text burned into dubbed videos.
DUBLAB_WATERMARK=made with DubLab

# ---- optional tuning (defaults shown) ----
# Speech-to-text model: base | small | medium | large-v3-turbo
# Bigger = more accurate ("small" or bigger recommended for Chinese) but slower.
DUBLAB_WHISPER_MODEL=base

# Longest video (minutes) — default only; change it live on the admin page.
# Largest upload / link download (MB) — set here only; restart after changing.
# For 1-hour videos use DUBLAB_MAX_MINUTES=60 and DUBLAB_MAX_MB=2000.
DUBLAB_MAX_MINUTES=30
DUBLAB_MAX_MB=3000

# Background music/effects volume under the dub voice, 0-1 (original voices are
# removed with Demucs first). 0 = no background at all.
DUBLAB_BG_VOLUME=0.8

# Optional: e-mail every new review/feedback to this address.
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and put it in DUBLAB_SMTP_PASSWORD.
DUBLAB_MAIL_TO=
DUBLAB_SMTP_USER=
DUBLAB_SMTP_PASSWORD=
# DUBLAB_SMTP_HOST=smtp.gmail.com
# DUBLAB_SMTP_PORT=465
