# Copy to .env and fill in your own keys. Never commit a real .env.

# Required: Gemini API key used for translation (free tier works).
GEMINI_API_KEY=

# Optional: comma-separated Gemini keys for TTS rotation.
# Falls back to GEMINI_API_KEY when empty.
GEMINI_TTS_API_KEYS=

# Optional: password for the /admin reviews page. Empty disables it.
DUBLAB_ADMIN_KEY=

# Optional: watermark text burned into dubbed videos.
DUBLAB_WATERMARK=made with DubLab

# ---- optional tuning (defaults shown) ----
# Default speech-to-text model preselected in the UI: small (accurate, best for
# Chinese) | base (about 2x faster). Users can switch per video.
DUBLAB_WHISPER_MODEL=small

# Longest video (minutes) — default only; change it live on the admin page.
# Largest upload / link download (MB) — set here only; restart after changing.
# For 1-hour videos use DUBLAB_MAX_MINUTES=60 and DUBLAB_MAX_MB=2000.
DUBLAB_MAX_MINUTES=30
DUBLAB_MAX_MB=3000

# Background music/effects volume under the dub voice, 0-1 (original voices are
# removed with Demucs first). 0 = no background at all.
DUBLAB_BG_VOLUME=0.8

# Optional: e-mail every new review/feedback to this address.
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and put it in DUBLAB_SMTP_PASSWORD.
DUBLAB_MAIL_TO=
DUBLAB_SMTP_USER=
DUBLAB_SMTP_PASSWORD=
# DUBLAB_SMTP_HOST=smtp.gmail.com
# DUBLAB_SMTP_PORT=465

# Optional: spoken at the end of every dub in the chosen voice (can also be
# set on the admin page). Empty = no outro.
DUBLAB_OUTRO=
# your channel name; replaces the original creator's channel name in the dub (editable on the admin page)
DUBLAB_CHANNEL_NAME=Marco Recap

# Optional: your fixed ngrok domain; ./ngrok exposes the app on it (HTTPS)
NGROK_DOMAIN=

# Optional: send finished dubs to your Telegram. Create a bot with @BotFather,
# paste its token here, send /start to the bot, then press Connect on the admin page.
TELEGRAM_BOT_TOKEN=
# Public address used in download links for files over the 50 MB bot limit
# (defaults to https://$NGROK_DOMAIN)
# PUBLIC_URL=https://example.com
# Shown on /terms and /privacy (defaults to DUBLAB_MAIL_TO)
# DUBLAB_CONTACT_EMAIL=
# DUBLAB_APP_NAME=DubLab
